#!/usr/bin/bash
set -Eeuo pipefail
die(){ echo "ERREUR : $*" >&2; exit 1; }
USER_NAME="${1:-}"; [[ -n "$USER_NAME" ]] || die "nom utilisateur manquant"; [[ "$USER_NAME" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || die "nom utilisateur invalide"
IFS=: read -r ACCOUNT_NAME _ USER_UID USER_GID _ USER_HOME _ < <(/usr/bin/getent passwd "$USER_NAME"); [[ "$ACCOUNT_NAME" == "$USER_NAME" ]] || die "compte incohérent"; [[ -d "$USER_HOME" ]] || die "home introuvable"
REQUEST_DIR=/run/linux-ntfs-akmod; REQUEST_FILE="$REQUEST_DIR/install-$USER_NAME.env"
[[ -d "$REQUEST_DIR" ]] || die "répertoire absent"; [[ -f "$REQUEST_FILE" && ! -L "$REQUEST_FILE" ]] || die "transaction absente/invalide"
[[ "$(/usr/bin/stat -c '%u:%g:%a' "$REQUEST_FILE")" == "$USER_UID:$USER_GID:600" ]] || die "propriétaire/permissions transaction incorrects"
mapfile -t LINES < "$REQUEST_FILE"; [[ "${#LINES[@]}" -eq 2 ]] || die "transaction invalide"
TARGET_AKMOD_RPM=""; EXPECTED_COMMIT=""
for LINE in "${LINES[@]}"; do case "$LINE" in TARGET_AKMOD_RPM=*) [[ -z "$TARGET_AKMOD_RPM" ]] || die "TARGET dupliqué"; TARGET_AKMOD_RPM="${LINE#TARGET_AKMOD_RPM=}";; EXPECTED_COMMIT=*) [[ -z "$EXPECTED_COMMIT" ]] || die "COMMIT dupliqué"; EXPECTED_COMMIT="${LINE#EXPECTED_COMMIT=}";; *) die "ligne inconnue";; esac; done
[[ "$TARGET_AKMOD_RPM" == /* && "$EXPECTED_COMMIT" =~ ^[0-9a-f]{40}$ ]] || die "transaction invalide"
RPM_ARCH="$(/usr/bin/rpm --eval '%{_arch}')"; RPM_DIR="$USER_HOME/rpmbuild/RPMS/$RPM_ARCH"
case "$TARGET_AKMOD_RPM" in "$RPM_DIR"/*) ;; *) die "RPM hors répertoire autorisé";; esac
[[ -f "$TARGET_AKMOD_RPM" && ! -L "$TARGET_AKMOD_RPM" ]] || die "RPM candidat invalide"; [[ "$(/usr/bin/readlink -f "$TARGET_AKMOD_RPM")" == "$TARGET_AKMOD_RPM" ]] || die "RPM non canonique"; [[ "$(/usr/bin/stat -c '%u:%g' "$TARGET_AKMOD_RPM")" == "$USER_UID:$USER_GID" ]] || die "RPM non possédé"
CANDIDATE_NAME="$(/usr/bin/rpm -qp --qf '%{NAME}' "$TARGET_AKMOD_RPM")"; CANDIDATE_VERSION="$(/usr/bin/rpm -qp --qf '%{VERSION}' "$TARGET_AKMOD_RPM")"; CANDIDATE_RELEASE="$(/usr/bin/rpm -qp --qf '%{RELEASE}' "$TARGET_AKMOD_RPM")"; CANDIDATE_ARCH="$(/usr/bin/rpm -qp --qf '%{ARCH}' "$TARGET_AKMOD_RPM")"
[[ "$CANDIDATE_NAME" == akmod-linux-ntfs && "$CANDIDATE_ARCH" == "$RPM_ARCH" ]] || die "identité AKMOD incorrecte"
CANDIDATE_COMMIT="$(/usr/bin/rpm -qp --changelog "$TARGET_AKMOD_RPM" 2>/dev/null | /usr/bin/grep -m1 -Eo 'Update to ntfs-next commit [0-9a-f]{40}' | /usr/bin/grep -Eo '[0-9a-f]{40}' | /usr/bin/head -n1 || true)"
[[ "$CANDIDATE_COMMIT" == "$EXPECTED_COMMIT" ]] || die "SHA candidat différent"
AKMOD_VERSION_RELEASE="$CANDIDATE_VERSION-$CANDIDATE_RELEASE"; KMOD_RPM="$RPM_DIR/kmod-linux-ntfs-$AKMOD_VERSION_RELEASE.$CANDIDATE_ARCH.rpm"; COMMON_RPM="$RPM_DIR/linux-ntfs-kmod-common-$AKMOD_VERSION_RELEASE.$CANDIDATE_ARCH.rpm"
for f in "$KMOD_RPM" "$COMMON_RPM"; do [[ -f "$f" && ! -L "$f" ]] || die "compagnon absent"; [[ "$(/usr/bin/stat -c '%u:%g' "$f")" == "$USER_UID:$USER_GID" ]] || die "compagnon non possédé"; done
[[ "$(/usr/bin/rpm -qp --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}' "$KMOD_RPM")" == "kmod-linux-ntfs-$AKMOD_VERSION_RELEASE.$CANDIDATE_ARCH" ]] || die "KMOD incohérent"
[[ "$(/usr/bin/rpm -qp --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}' "$COMMON_RPM")" == "linux-ntfs-kmod-common-$AKMOD_VERSION_RELEASE.$CANDIDATE_ARCH" ]] || die "common incohérent"
INSTALLED_NEVA=""; INSTALLED_COMMIT=""; if /usr/bin/rpm -q akmod-linux-ntfs >/dev/null 2>&1; then INSTALLED_VERSION="$(/usr/bin/rpm -q --qf '%{VERSION}' akmod-linux-ntfs)"; INSTALLED_RELEASE="$(/usr/bin/rpm -q --qf '%{RELEASE}' akmod-linux-ntfs)"; INSTALLED_ARCH="$(/usr/bin/rpm -q --qf '%{ARCH}' akmod-linux-ntfs)"; INSTALLED_NEVA="$INSTALLED_VERSION-$INSTALLED_RELEASE.$INSTALLED_ARCH"; INSTALLED_COMMIT="$(/usr/bin/rpm -q --changelog akmod-linux-ntfs 2>/dev/null | /usr/bin/grep -m1 -Eo 'Update to ntfs-next commit [0-9a-f]{40}' | /usr/bin/grep -Eo '[0-9a-f]{40}' | /usr/bin/head -n1 || true)"; fi
CANDIDATE_NEVA="$CANDIDATE_VERSION-$CANDIDATE_RELEASE.$CANDIDATE_ARCH"; [[ "$INSTALLED_NEVA" != "$CANDIDATE_NEVA" || "$INSTALLED_COMMIT" == "$EXPECTED_COMMIT" ]] || die "collision NEVRA avec SHA différent"
/usr/bin/dnf5 -y install --allow-downgrade "$COMMON_RPM" "$TARGET_AKMOD_RPM" "$KMOD_RPM"
/usr/bin/dracut --force --kver "$(/usr/bin/uname -r)"
/usr/bin/modprobe ntfs
/usr/bin/rm -f -- "$REQUEST_FILE"
